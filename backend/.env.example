# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# ── Razorpay Test-Mode Integration (M10) ─────────────────────────────────────
# All three variables are required for the Razorpay webhook endpoint to accept
# and process payment.failed events. If any are missing the endpoint returns
# HTTP 503 and refuses to process events.
#
# IMPORTANT: Use Razorpay TEST MODE keys only (prefix: rzp_test_).
# Never use production (rzp_live_) keys. No real money is involved.
#
# Obtain test credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Obtain webhook secret from: Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
